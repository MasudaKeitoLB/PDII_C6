{
  "name": "hoho-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "歩歩〜HoHo〜 利用者アプリ（はじめての設定・ログイン）の試作",
  "scripts": {
    "dev": "vite --host",
