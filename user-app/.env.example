# サーバー（Supabase）の接続の値の ひな形。
# 使うときは このファイルを .env.local に写して、値を入れる。
# .env.local は git に入らない。値は チャットや コードに 貼らない。
# 値が空のときは、今までどおり ブラウザの中だけで 動く。

# プロジェクトの URL（https:// で始まる）
VITE_SUPABASE_URL=
# 公開してよいキー（sb_publishable_ で始まる）。secret key は 入れない
VITE_SUPABASE_PUBLISHABLE_KEY=
# 古い形のキー（anon key）を 使うときだけ。ふつうは 空のまま
VITE_SUPABASE_ANON_KEY=
